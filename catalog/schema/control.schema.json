{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofplane.dev/schema/control.schema.json",
  "title": "proofplane control",
  "description": "A control claim about a system, the probe that proves it, and the framework requirements it bears on. Every mapping states its own confidence and basis; see docs/decisions/0004.",
  "type": "object",
  "required": ["id", "title", "guardrail", "statement", "rationale", "proved_by", "assertion", "crosswalk"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^PP-C[0-9]{3}$" },
    "title": { "type": "string", "minLength": 10 },
    "guardrail": {
      "type": "string",
      "pattern": "^G[0-9]+$",
      "description": "The toggleable guardrail in the target that implements this control. One-to-one with controls, so the independence matrix has a meaningful diagonal."
    },
    "statement": { "type": "string", "minLength": 20 },
    "rationale": { "type": "string", "minLength": 20 },
    "limits": { "type": "string" },
    "proved_by": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^PP-P[0-9]{3}$" },
      "description": "A control with no probe is an assertion. The loader rejects an empty list."
    },
    "assertion": {
      "type": "object",
      "required": ["type", "passes_when"],
      "properties": {
        "type": { "const": "executed_probe" },
        "passes_when": { "type": "string" },
        "fails_when": { "type": "string" }
      }
    },
    "threat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "atlas": { "$ref": "#/$defs/threatList" },
        "owasp_asi": { "$ref": "#/$defs/threatList" }
      }
    },
    "crosswalk": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mapping" }
    },
    "references": { "type": "array", "items": { "type": "string", "format": "uri" } }
  },
  "$defs": {
    "confidence": {
      "enum": ["high", "medium", "low"],
      "description": "How well established this mapping is. Not how important it is."
    },
    "threatList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "confidence": { "$ref": "#/$defs/confidence" }
        }
      }
    },
    "mapping": {
      "type": "object",
      "required": ["framework", "reference", "reference_kind", "confidence", "basis"],
      "additionalProperties": false,
      "properties": {
        "framework": { "type": "string" },
        "reference": { "type": "string" },
        "reference_kind": {
          "enum": [
            "article",
            "annex_a_group",
            "annex_a_control",
            "subcategory",
            "domain",
            "principle_name",
            "theme",
            "unspecified"
          ],
          "description": "The granularity actually being asserted. Citing a group as a group is honest; citing a group as a sub-control is not."
        },
        "label": { "type": "string" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "basis": {
          "type": "string",
          "minLength": 10,
          "description": "Why this mapping, and what was not verified. An unexplained mapping is an assertion."
        }
      }
    }
  }
}
